# Supabase Configuration (Required for Production Database, Auth & Realtime)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google Gemini API Key (Used by Server-Side Vector Generation Edge Listener)
GEMINI_API_KEY="your-gemini-api-key"

# Optional Remote Redis Layer for Adamic-Adar Graph & Embedding Cache (Falls back to In-Memory LRU)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# App Public Base URL (Used for Share Links & OpenGraph Cards on Vercel)
VITE_APP_URL="https://bopoi.vercel.app"

